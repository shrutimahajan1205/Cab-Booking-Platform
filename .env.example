# Environment Variables Configuration

# Security & Tokens
SECRET_KEY=super-secret-key-cab-booking-2026-production-ready
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local Standalone (Default zero setup): sqlite+aiosqlite:///./cab_booking.db
# PostgreSQL with PostGIS: postgresql+asyncpg://cab_user:cab_password@localhost:5432/cab_booking
DATABASE_URL=sqlite+aiosqlite:///./cab_booking.db

# Redis Message Broker & Caching
REDIS_URL=redis://localhost:6379/0

# Stripe Payments (Set your keys or keep mock defaults for offline review)
STRIPE_SECRET_KEY=sk_test_mock_secret_key_cab_booking
STRIPE_PUBLISHABLE_KEY=pk_test_mock_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret

# Google Maps API (Optional, Leaflet + OpenStreetMap works out-of-the-box)
GOOGLE_MAPS_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
